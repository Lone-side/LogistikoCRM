# LogistikoCRM — Office/LAN environment template (εσωτερικό HTTPS, χωρίς Internet)
# Αντιγραφή: cp .env.office.example .env
# Χρήση με:  docker compose -f docker-compose.prod.yml -f docker-compose.office.yml up -d --build
# Πλήρης οδηγός: docs/OFFICE_RUNBOOK.md
#
# ΚΑΝΟΝΑΣ: αυτό το αρχείο ΔΕΝ περιέχει πραγματικά secrets — τα κενά
# πεδία συμπληρώνονται ΜΟΝΟ στο αντίγραφο .env του server (εκτός git).

# ==================== ΥΠΟΧΡΕΩΤΙΚΑ ====================

# Βλ. .env.production.example για την πλήρη εξήγηση: το DEBUG=False ΔΕΝ
# υποκαθιστά το DJANGO_ENV — χωρίς 'production' τα manage.py commands
# τρέχουν σε development mode ή αποτυγχάνουν fail-closed.
DJANGO_ENV=production

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Κωδικός PostgreSQL (δημιουργείται με αυτόν η βάση στο πρώτο up)
DB_PASSWORD=

# Token για το Fritz!Box webhook — υποχρεωτικό σε παραγωγή ακόμη κι αν
# δεν χρησιμοποιείται. Δημιουργία: openssl rand -hex 32
FRITZ_API_TOKEN=

# Κλειδί κρυπτογράφησης (Fernet) για credentials πελατών/myDATA/SMTP.
# Δημιουργία: python scripts/generate_fernet_key.py
DATA_ENCRYPTION_KEY_CURRENT=
DATA_ENCRYPTION_KEY_PREVIOUS=
DATA_ENCRYPTION_KEY_ID=

# RBAC: υποχρεωτικό με πραγματικά δεδομένα πελατών — οι χρήστες βλέπουν
# μόνο ανατεθειμένους πελάτες (σειρά: setup_roles → groups → αναθέσεις,
# βλ. docs/OFFICE_RUNBOOK.md). ΜΗΝ ορίσετε ALLOW_UNSCOPED_CLIENT_ACCESS
# σε office εγκατάσταση.
ENFORCE_CLIENT_ASSIGNMENT=True
ALLOW_UNSCOPED_CLIENT_ACCESS=False

# Fail-safe production containment: παλιά AppConfig daemon threads δεν
# ξεκινούν σε web/Celery/migrations. Οι scheduled εργασίες ανήκουν στο Celery.
LEGACY_APP_THREADS_ENABLED=False

# ==================== LAN / HTTPS ====================

# Η ΣΤΑΤΙΚΗ LAN IP του server — το nginx δένει ΜΟΝΟ εδώ (ποτέ 0.0.0.0).
# Το docker compose αρνείται να ξεκινήσει χωρίς αυτήν.
OFFICE_BIND_IP=192.168.1.10

# Το εσωτερικό hostname του CRM. Οι υπολογιστές του γραφείου το
# αναλύουν είτε μέσω τοπικού DNS είτε μέσω hosts file (βλ. runbook).
# Χρησιμοποιείται και από το scripts/office_certs.sh για το certificate.
OFFICE_HOSTNAME=crm.office.lan

# Hostnames/IPs που δέχεται το Django. ΧΩΡΙΣ '*'. Απαιτούνται ΚΑΙ το
# hostname ΚΑΙ η IP (τα manage.py commands διαβάζουν ΜΟΝΟ αυτή τη λίστα
# — webcrm/settings_local.py — ενώ ο gunicorn την προσθέτει στα LAN
# defaults του webcrm/settings.py).
ALLOWED_HOSTS=crm.office.lan,192.168.1.10

# CSRF origins — ΜΟΝΟ https:// (η iframe φόρμα και το admin θα
# απορρίπτουν POST χωρίς σωστή λίστα).
CSRF_TRUSTED_ORIGINS=https://crm.office.lan,https://192.168.1.10

# Χρησιμοποιείται σε emails/links προς χρήστες
SITE_URL=https://crm.office.lan

# Το nginx του office profile τερματίζει TLS και στέλνει
# X-Forwarded-Proto — υποχρεωτικό True, αλλιώς redirect loop.
# (Το docker-compose.office.yml το επιβάλλει ούτως ή άλλως.)
USE_X_FORWARDED_PROTO=True

# ==================== DATABASE (προαιρετικά overrides) ====================
# DB_NAME=logistikocrm
# DB_USER=logistiko

# ==================== EMAIL ====================
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=crm@example.gr
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=crm@example.gr

# ==================== myDATA (ΑΑΔΕ) — ΜΟΝΟ SANDBOX ====================
# Η office εγκατάσταση μένει ΥΠΟΧΡΕΩΤΙΚΑ σε sandbox (mydataapidev) μέχρι
# να ολοκληρωθεί το end-to-end runbook (docs/MYDATA_SANDBOX_TEST.md).
# ΠΡΟΣΟΧΗ: το office_preflight αποτυγχάνει αν οριστεί False. Επίσης τα
# per-client credentials στο CRM έχουν ΔΙΚΟ τους sandbox flag με default
# ΠΑΡΑΓΩΓΗ (is_sandbox=False) — το preflight προειδοποιεί αν υπάρχουν.
MYDATA_IS_SANDBOX=True
# MYDATA_USER_ID=aade_username
# MYDATA_SUBSCRIPTION_KEY=
# MYDATA_ISSUER_VAT=

# ==================== ΠΡΟΑΙΡΕΤΙΚΑ ====================
# Διάρκεια signed media links σε δευτερόλεπτα (default 4 ώρες)
# MEDIA_TOKEN_MAX_AGE=14400
# OCR για σκαναρισμένα PDF (θέλει tesseract στο image)
# DOCUMENT_OCR_ENABLED=False
