# LogistikoCRM — Production environment template
# Αντιγραφή: cp .env.production.example .env
# Χρήση με:  docker compose -f docker-compose.prod.yml up -d --build

# ==================== ΥΠΟΧΡΕΩΤΙΚΑ ====================

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Κωδικός PostgreSQL (θα δημιουργηθεί με αυτόν η βάση στο πρώτο up)
DB_PASSWORD=

# Token για το Fritz!Box webhook — υποχρεωτικό σε παραγωγή ακόμη κι αν
# δεν χρησιμοποιείται το Fritz monitor (αλλιώς το app δεν ξεκινά).
# Δημιουργία: openssl rand -hex 32
FRITZ_API_TOKEN=

# ==================== SITE ====================

# Το δημόσιο URL της εγκατάστασης (χρησιμοποιείται σε emails/links)
SITE_URL=http://crm.example.gr

# Επιπλέον hostnames που δέχεται το Django (comma-separated)
ALLOWED_HOSTS=crm.example.gr

# Με HTTPS μπροστά (certbot/cloudflare): υποχρεωτικό για CSRF
# CSRF_TRUSTED_ORIGINS=https://crm.example.gr
# USE_X_FORWARDED_PROTO=True

# Πόρτα του nginx στον host
HTTP_PORT=80

# ==================== DATABASE (προαιρετικά overrides) ====================
# DB_NAME=logistikocrm
# DB_USER=logistiko

# ==================== EMAIL ====================
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=crm@example.gr
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=crm@example.gr

# ==================== myDATA (ΑΑΔΕ) ====================
# Credentials του γραφείου για αποστολή τιμολογίων (όχι των πελατών —
# αυτά μπαίνουν ανά πελάτη μέσα από το CRM)
# MYDATA_USER_ID=aade_username
# MYDATA_SUBSCRIPTION_KEY=
# ΑΦΜ του γραφείου (εκδότης τιμολογίων)
# MYDATA_ISSUER_VAT=
# ΠΡΟΣΟΧΗ: False = πραγματική υποβολή στην ΑΑΔΕ
# MYDATA_IS_SANDBOX=True

# ==================== ΠΡΟΑΙΡΕΤΙΚΑ ====================
# Διάρκεια signed media links σε δευτερόλεπτα (default 4 ώρες)
# MEDIA_TOKEN_MAX_AGE=14400
# OCR για σκαναρισμένα PDF (θέλει tesseract στο image)
# DOCUMENT_OCR_ENABLED=False
