# ============================================================
# LogistikoCRM - Ρυθμίσεις Ανάπτυξης (Development)
# ============================================================
# Αντιγράψτε σε .env: cp .env.development .env
# Το SECRET_KEY δημιουργείται αυτόματα κατά την πρώτη εκκίνηση.
# ΠΟΤΕ μην κάνετε commit το .env στο git!
#
# Για όλες τις προαιρετικές ρυθμίσεις (VoIP, myDATA, GSIS, IoT):
# δείτε το .env.development.full
# ============================================================

# --- Απαιτείται ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Βάση δεδομένων (SQLite για dev, δεν χρειάζεται ρύθμιση) ---
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Για PostgreSQL αποσχολιάστε:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=logistiko
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Email (εκτυπώνεται στο terminal για dev) ---
EMAIL_BACKEND_CONSOLE=true

# Για πραγματικό SMTP αποσχολιάστε:
# EMAIL_BACKEND_CONSOLE=false
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_PORT=587
# EMAIL_USE_TLS=true

# --- Στοιχεία γραφείου (προαιρετικά) ---
# COMPANY_NAME=Το Λογιστήριό μου
# ACCOUNTANT_NAME=Ονοματεπώνυμο
# ARCHIVE_ROOT=/path/to/client/files
